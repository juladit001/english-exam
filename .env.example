# Postgres connection string. On Vercel, adding Neon from the Storage tab sets DATABASE_URL for you.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# A long random string used to sign login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Optional: if set, creating an account requires this code. Leave it set so strangers can't sign up.
SIGNUP_CODE=
